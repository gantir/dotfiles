// Platzieren Sie Ihre Einstellungen in dieser Datei, um die Standardeinstellungen zu überschreiben.
{
    "window.zoomLevel": 0,
    "FSharp.enableTreeView": true,
    "workbench.startupEditor": "newUntitledFile",
    "extensions.ignoreRecommendations": false,
    "editor.fontFamily": "Monoid NF, Menlo, Monaco, 'Courier New', monospace",
    "editor.fontLigatures": true,
    "terminal.integrated.fontFamily": "Monoid NF",
    "workbench.iconTheme": "vscode-great-icons",
    "workbench.colorTheme": "Gruvbox Dark (Medium)",
    "files.exclude": {
        "**/.git": true,
        "**/.svn": true,
        "**/.hg": true,
        "**/CVS": true,
        "**/.DS_Store": true,
        "**/.fake": true,
        "**/paket-files": true
    },
    "files.associations": {
        "*.tidal": "haskell"
    },
    "tidalcycles.showOutputInConsoleChannel": true,
    "git.enableSmartCommit": true,
    "security.workspace.trust.untrustedFiles": "open",
    "workbench.editorAssociations": {
        "*.ipynb": "jupyter.notebook.ipynb"
    },
    "editor.minimap.enabled": false,
    "redhat.telemetry.enabled": false,
    "files.autoSave": "afterDelay",
    "editor.multiCursorModifier": "ctrlCmd",
    "editor.wordWrap": "on",
    "editor.quickSuggestions": true,
    "telemetry.enableTelemetry": false,
    "merge-conflict.diffViewPosition": "Beside"
}
